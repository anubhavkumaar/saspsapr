rules_version = '2';

// Security rules for project `saspsapr`. Started on 2026-10-27 as a verbatim copy of production
// (release projects/saspsapr/releases/cloud.firestore -> ruleset 43294e32-d408-43ac-b1ee-7b525083e833, published 2026-04-21),
// then changed in the three places listed below. Anything not listed is exactly as it was in that ruleset.
//
// History: this file used to be a transcription of a comment block in src/firebase.js. That block was an older,
// looser draft (any signed-in account could write sapr_users and sapr_roster, no role checks) with no rule for
// sapr_posts. Deploying that version would have loosened production and broken the Ranger announcements.
//
// Changes made here since that release (2026-10-27):
//   1. sapr_submissions: anyone may create. The public application form writes an audit entry (device fingerprint,
//      citizen ID, Discord) after each submission and ignores a refusal; the old rule (signed-in only) refused every
//      anonymous applicant, so nothing was recorded after 30 April.
//   2. sapr_applications: a ranger may `get` the application their own account is linked to, so the Ranger portal can show
//      their origin department and citizen ID. They cannot list applications or read any other one.
//   3. sapr_users: a ranger can no longer change `applicationId` on their own document (only `role` was protected before);
//      without this, change 2 would let them point it at someone else's application.
//
// In short:
//   - A role lives on sapr_users/<email with @ and . replaced by _>.role. Three allowlisted emails are always management.
//   - management: writes sapr_users (including role), sapr_roster, sapr_config, sapr_user_secrets; reads and changes
//     sapr_applications and sapr_submissions; creates, edits and deletes sapr_posts.
//   - ranger: reads sapr_posts and their own linked application; edits and deletes fishing_evidence and sapr_mdt; edits
//     their own sapr_users document but not its `role` or `applicationId`.
//   - anyone, signed in or not: reads fishing_evidence, sapr_mdt, sapr_users, sapr_roster, sapr_config; creates
//     sapr_applications and sapr_submissions (the application form is public).
//   - blocked accounts are refused creates on fishing_evidence and sapr_mdt, and reads of sapr_posts.
//
// The ruleset can also be edited in the console: compare with production before deploying from this file.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailToId() {
      return request.auth.token.email.replace('[@.]', '_');
    }

    function isAllowlistAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'sapr@anubhav.gg',
          'eddiebrock@sapr.gg',
          'rexdavis@sapr.gg'
        ];
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/sapr_users/$(emailToId())).data;
    }

    function hasRole(r) {
      return signedIn()
        && exists(/databases/$(database)/documents/sapr_users/$(emailToId()))
        && myUserDoc().role == r;
    }

    function isManagement() {
      return isAllowlistAdmin() || hasRole('management');
    }

    function isRanger() {
      return isManagement() || hasRole('ranger');
    }

    function isBlocked() {
      return hasRole('blocked');
    }

    match /fishing_evidence/{doc} {
      allow read:           if true;
      allow create:         if signedIn() && !isBlocked();
      allow update, delete: if isRanger() && !isBlocked();
    }

    match /sapr_mdt/{doc} {
      allow read:           if true;
      allow create:         if signedIn() && !isBlocked();
      allow update, delete: if isRanger() && !isBlocked();
    }

    match /sapr_users/{docId} {
      allow read:   if true;
      allow create: if isManagement();
      allow update: if isManagement()
                    || (docId == emailToId()
                        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                        && !('applicationId' in request.resource.data.diff(resource.data).affectedKeys()));
      allow delete: if isManagement();
    }

    match /sapr_user_secrets/{doc} {
      allow read, write: if isManagement();
    }

    match /sapr_applications/{doc} {
      allow create:             if true;
      allow read, update, delete: if isManagement();
      // A ranger may read the one application their own account is linked to (the Ranger portal overview shows its
      // origin department and citizen ID). Only `get`, never a listing; and `applicationId` cannot be self-edited (see sapr_users).
      allow get:                if hasRole('ranger') && doc == myUserDoc().get('applicationId', '');
    }

    match /sapr_config/{doc} {
      allow read:  if true;
      allow write: if isManagement();
    }

    match /sapr_roster/{doc} {
      allow read:  if true;
      allow write: if isManagement();
    }

    match /sapr_posts/{doc} {
      allow read:                   if isRanger() && !isBlocked();
      allow create, update, delete: if isManagement();
    }

    match /sapr_submissions/{doc} {
      allow create:             if true;
      allow read, update, delete: if isManagement();
    }
  }
}
